# Copy this file to .env for a production deployment.
# configure-production-env.js replaces GENERATE_ON_DEPLOY values with fresh secrets.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/secureasset
CLIENT_URL=https://secureasset.in
PUBLIC_APP_URL=https://secureasset.in
# The public hostname must resolve directly to this server. The deployment
# never contacts an external edge or cache service.
JWT_ACCESS_SECRET=GENERATE_ON_DEPLOY
JWT_REFRESH_SECRET=GENERATE_ON_DEPLOY
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ROLLING_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
SESSION_RENEWAL_WINDOW_HOURS=24
SESSION_ROTATION_GRACE_SECONDS=60
JWT_ISSUER=secureasset-api
JWT_AUDIENCE=secureasset-web
ENCRYPTION_MASTER_KEY_BASE64=GENERATE_ON_DEPLOY
LEGACY_PUBLIC_UPLOADS=false
PAYMENT_AUTO_APPROVE=false
STORAGE_DRIVER=local
VAULT_STORAGE_DIR=/var/lib/secureasset/vault
VAULT_ENCRYPTION_KEY=GENERATE_ON_DEPLOY
VAULT_TEMP_DIR=/var/lib/secureasset/tmp
VAULT_MAX_FILE_MB=250
VAULT_CHUNK_MB=12
TRASH_RETENTION_DAYS=60
VAULT_PURGE_CRON=17 2 * * *
# Encrypted full-system backups: MongoDB, uploaded vault/data, source code.
# The server creates a new retained encrypted archive daily at 5 PM IST.
BACKUP_STORAGE_DIR=/var/lib/secureasset/backup-pull/archives
BACKUP_TEMP_DIR=/var/lib/secureasset/backup-tmp
BACKUP_ENCRYPTION_KEY_BASE64=GENERATE_ON_DEPLOY
BACKUP_RETENTION_DAYS=90
BACKUP_CRON=0 17 * * *
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_RESTORE_TOKEN_TTL_MINUTES=15
CLAMAV_ENABLED=false
CLAMAV_COMMAND=clamdscan
VITE_API_URL=/api/v1
CMS_ASSET_DIR=/var/lib/secureasset/site-assets
# Optional SMTP delivery. Production mail transport always requires TLS when
# SMTP is configured and rejects invalid certificates.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RENT_AUTOMATION_CRON=* * * * *
NOTIFICATION_DELIVERY_CRON=* * * * *
NOTIFICATION_BATCH_SIZE=200
PM2_MAX_MEMORY=1G
AUTO_DB_MIGRATIONS=true
AUTO_DB_MIGRATION_LOCK_TTL_MS=1200000
AUTO_DB_MIGRATION_WAIT_MS=1800000
AUTO_DB_MIGRATION_POLL_MS=3000
SEED_DEMO_RENTAL_DATA=false

# Optional Google Maps credentials. Prefer the encrypted admin Maps &
# Navigation settings for provider credentials. The browser key is used only
# by Maps JavaScript; all backend keys/tokens stay server-side.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
GOOGLE_MAPS_ROUTES_API_KEY=
GOOGLE_MAPS_PLACES_API_KEY=
GOOGLE_MAPS_ELEVATION_API_KEY=
GOOGLE_MAPS_ROADS_API_KEY=
GOOGLE_MAPS_ADDRESS_VALIDATION_API_KEY=
GOOGLE_MAPS_GROUNDING_LITE_API_KEY=
GOOGLE_MAPS_CLOUD_PROJECT_ID=
GOOGLE_MAPS_NAVIGATION_CONNECT_ACCESS_TOKEN=
GOOGLE_MAPS_ROUTE_OPTIMIZATION_ACCESS_TOKEN=
GOOGLE_MAPS_STREETVIEW_ACCESS_TOKEN=
